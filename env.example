# ============================================================
# .env.example — All environment variables
# Copy to .env.local and fill in values
# ⚠️ Never commit .env.local to git
# ============================================================

# --- Site ---------------------------------------------------|
NEXT_PUBLIC_BASE_URL=https://yourdomain.com
NEXT_PUBLIC_SITE_NAME=Studio
NEXT_PUBLIC_AUTHOR_NAME=Your Name

# --- Analytics ---------------------------------------------|
# Get from Google Analytics 4 → Admin → Data Streams
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# --- Email (Resend) ----------------------------------------|
# resend.com → API Keys → Create
RESEND_API_KEY=re_xxxxxxxxxxxx
# Must use verified domain
FROM_EMAIL=noreply@yourdomain.com
OWNER_EMAIL=you@yourdomain.com

# --- Telegram (optional) -----------------------------------|
# @BotFather → /newbot → copy token
TELEGRAM_BOT_TOKEN=
# @userinfobot → send /start → copy id
TELEGRAM_CHAT_ID=

# --- AI Chat + RAG (optional) -----------------------------|
# platform.openai.com → API Keys
OPENAI_API_KEY=

# --- WhatsApp (optional) ----------------------------------|
NEXT_PUBLIC_WHATSAPP_NUMBER=
